# Solana RPC endpoint - use Helius/QuickNode for production (public RPC has strict rate limits)
# Mainnet example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Testnet: https://api.testnet.solana.com
SOLANA_RPC_URL=""
PROGRAM_ID=""
ADMIN_API_KEY=""
BERYX_API_KEY=
FILECOIN_NETWORK=calibration or mainnet
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_REPLY_TO=""
# Generate your admin keypair by running: ./scripts/generate-admin-key.sh
# Then paste the keypair array below:
ADMIN_KEYPAIR='[paste keypair array here]'

# ── IPFS / Kubo (meshkit) ─────────────────────────────────────────────────────
# Comma-separated list of Kubo RPC endpoints.
# Meshkit health-checks all nodes at startup and routes through the first
# healthy one with automatic failover.
#
# Mix local + remote freely — any URL containing 127.0.0.1 or localhost
# causes meshkit to start/attach the local daemon; all other URLs are treated
# as remote nodes (no daemon spawn).
#
# Examples:
#   Hosted Render Kubo (recommended for demos / no local daemon):
#     KUBO_NODES=https://kubo-render.onrender.com
#   Local only (default when this var is unset):
#     KUBO_NODES=
#   Remote Akamai node only:
#     KUBO_NODES=http://kubo.akamai.example.com:5001
#   Local primary + Render failover:
#     KUBO_NODES=http://127.0.0.1:5001,https://kubo-render.onrender.com
KUBO_NODES=https://kubo-render.onrender.com

# Single-node shorthand (used when KUBO_NODES is not set).
# Defaults to http://127.0.0.1:5001 when both vars are absent.
KUBO_API_URL="https://kubo-render.onrender.com"

# Public IPFS gateway used to build retrieval URLs returned to clients.
# Defaults to http://127.0.0.1:8080 (local Kubo gateway) when unset.
# For a remote node the gateway is auto-derived by swapping :5001 → :8080
# unless this var overrides it. Same-origin gateways (Render) use the API host.
IPFS_GATEWAY="https://kubo-render.onrender.com"

# Storage quota in MB for usage alerts (80 / 90 / 95 % thresholds).
IPFS_PLAN_LIMIT_MB=10240

# ── PPT token gate (Arbitrum Sepolia) ─────────────────────────────────────────
# Park Pro Token — matches IPFS-meshkit gated-access preset.
# Token: 0x38c505EE3FDf02C0A041B08611aDB2F1d92DF410
# Fee: 1 PPT (1e18) per MeshKit upload / retrieve
PPT_TREASURY=0xe98106BFfEd8A04979A351456ad5D2b4eE2dbDe8
PPT_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

