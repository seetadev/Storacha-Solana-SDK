VITE_API_URL=
VITE_API_URL_STAGING=
VITE_SOLANA_NETWORK=mainnet-beta
VITE_HELIUS_PROXY_URL=
VITE_FILECOIN_NETWORK=mainnet
VITE_WALLETCONNECT_PROJECT_ID=
# Sepolia (Ethereum testnet) — optional, public RPC is used when unset
VITE_SEPOLIA_RPC_URL=
# Arbitrum Sepolia — PPT token payments for MeshKit
VITE_ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Arbitrum One (mainnet) — USDC payments
VITE_ARB_RPC_URL=https://arb1.arbitrum.io/rpc
# Ethereum mainnet RPC — optional, public RPC is used when unset
VITE_ETH_RPC_URL=
# Arbitrum network selection: mainnet | sepolia | both (default: both)
VITE_ARBITRUM_NETWORK=both
# USDC on Arbitrum Sepolia (testnet) — override default when needed
VITE_ARB_SEPOLIA_USDC=
# Treasury that receives 1 PPT per MeshKit op (defaults to PPT deployer)
VITE_PPT_TREASURY=0xe98106BFfEd8A04979A351456ad5D2b4eE2dbDe8
